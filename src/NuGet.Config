<?xml version="1.0" encoding="utf-8"?>
<!--
  Local NuGet config, scoped to this folder so it does not leak into other
  .NET projects on the developer machine. Adds the official nuget.org feed so
  `dotnet publish` can resolve the self-contained runtime packs
  (Microsoft.NETCore.App.Runtime.win-*, Microsoft.WindowsDesktop.App.Runtime.win-*)
  even on hosts with no global NuGet sources configured — e.g. machines
  without Visual Studio, or CI runners with a locked-down config.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
